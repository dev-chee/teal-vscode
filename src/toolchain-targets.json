{
  "repository": "dev-chee/teal",
  "targets": {
    "win32-x64": {
      "rustTarget": "x86_64-pc-windows-msvc",
      "runner": "windows-2022",
      "extensionHost": true
    },
    "win32-arm64": {
      "rustTarget": "aarch64-pc-windows-msvc",
      "runner": "windows-11-arm",
      "extensionHost": true
    },
    "linux-x64": {
      "rustTarget": "x86_64-unknown-linux-gnu",
      "runner": "ubuntu-22.04",
      "extensionHost": true
    },
    "linux-arm64": {
      "rustTarget": "aarch64-unknown-linux-gnu",
      "runner": "ubuntu-22.04-arm",
      "extensionHost": true
    },
    "linux-armhf": {
      "rustTarget": "armv7-unknown-linux-gnueabihf",
      "runner": "ubuntu-22.04",
      "extensionHost": false
    },
    "alpine-x64": {
      "rustTarget": "x86_64-unknown-linux-musl",
      "runner": "ubuntu-22.04",
      "extensionHost": false
    },
    "alpine-arm64": {
      "rustTarget": "aarch64-unknown-linux-musl",
      "runner": "ubuntu-22.04-arm",
      "extensionHost": false
    },
    "darwin-x64": {
      "rustTarget": "x86_64-apple-darwin",
      "runner": "macos-15-intel",
      "extensionHost": true
    },
    "darwin-arm64": {
      "rustTarget": "aarch64-apple-darwin",
      "runner": "macos-15",
      "extensionHost": true
    }
  }
}
