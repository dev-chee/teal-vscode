{
  "name": "Teal",
  "scopeName": "source.teal",
  "patterns": [
    { "name": "comment.line.double-slash.teal", "begin": "//", "end": "$" },
    { "name": "string.quoted.double.teal", "begin": "\"", "end": "\"", "patterns": [
      { "name": "constant.character.escape.teal", "match": "\\\\.|\\{\\{|\\}\\}" },
      { "name": "meta.interpolation.teal", "contentName": "meta.embedded.inline.teal", "begin": "\\{", "end": "\\}|(?=\")", "patterns": [
        { "include": "#namespaces" },
        { "include": "#receiver" },
        { "name": "variable.other.property.teal", "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "variable.other.readwrite.teal", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "punctuation.accessor.teal", "match": "::|\\." }
      ] }
    ] },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "name": "entity.name.label.teal", "match": "'[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "keyword.control.teal", "match": "\\b(?:if|else|match|for|in|try|catch|return|break|continue|loop|await)\\b" },
    { "name": "storage.type.teal", "match": "\\b(?:dylib|host|import|pub|impl|trait|as|fn|class|enum|let|static|const|reflect|struct|type|agent|task)\\b" },
    { "name": "support.type.teal", "match": "\\b(?:int|float|bool|string|Task|Error)\\b" },
    { "name": "constant.language.teal", "match": "\\b(?:none|true|false|_)\\b" },
    { "include": "#receiver" },
    { "name": "constant.numeric.teal", "match": "(?<![A-Za-z_0-9])(?:[0-9]*\\.[0-9]+|[0-9]+)" },
    { "include": "#namespaces" },
    { "name": "entity.name.function.teal", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
    { "name": "keyword.operator.teal", "match": "[-+*/%^!=<>|&:?]+|@|\\.\\." },
    { "name": "punctuation.section.teal", "match": "[{}()\\[\\],;.]" }
  ],
  "repository": {
    "attributes": {
      "name": "entity.other.attribute-name.teal",
      "match": "@[ \\t]*[A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|task)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.teal" },
            "2": { "name": "entity.name.function.teal" }
          }
        },
        {
          "match": "\\b(class|struct|enum|trait|agent|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.teal" },
            "2": { "name": "entity.name.type.teal" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.teal" },
            "2": { "name": "variable.other.constant.teal" }
          }
        }
      ]
    },
    "namespaces": {
      "name": "entity.name.namespace.teal",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*::)"
    },
    "receiver": {
      "name": "variable.language.teal",
      "match": "\\bself\\b"
    }
  }
}
